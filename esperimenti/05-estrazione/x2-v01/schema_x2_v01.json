{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "UC-01 X2 extraction v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "note_id",
    "actions"
  ],
  "properties": {
    "note_id": {
      "type": "string"
    },
    "actions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "action_quote",
          "action_span",
          "context",
          "relations"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "action_quote": {
            "type": "string",
            "minLength": 1
          },
          "action_span": {
            "$ref": "#/$defs/span"
          },
          "context": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "quote",
                "span",
                "role"
              ],
              "properties": {
                "quote": {
                  "type": "string",
                  "minLength": 1
                },
                "span": {
                  "$ref": "#/$defs/span"
                },
                "role": {
                  "enum": [
                    "time",
                    "place",
                    "recipient",
                    "object_reference",
                    "condition",
                    "polarity",
                    "modality",
                    "other"
                  ]
                }
              }
            }
          },
          "relations": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "target_id",
                "type"
              ],
              "properties": {
                "target_id": {
                  "type": "string"
                },
                "type": {
                  "enum": [
                    "before",
                    "after",
                    "depends_on",
                    "contrasts_with"
                  ]
                }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "span": {
      "type": "array",
      "prefixItems": [
        {
          "type": "integer",
          "minimum": 0
        },
        {
          "type": "integer",
          "minimum": 0
        }
      ],
      "minItems": 2,
      "maxItems": 2
    }
  }
}
